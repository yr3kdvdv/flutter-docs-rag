# Copy to .env (git-ignored) and fill in locally. Never paste keys into chats.
# See docs/SETUP_ACCOUNTS.md.

# Gemini API (Google AI Studio): LLM + embeddings
GEMINI_API_KEY=

# Langfuse Cloud project: Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Voyage AI: second embedding model and reranker (needed from stage 05)
VOYAGE_API_KEY=

# Optional: raises GitHub API rate limit for the grabber (read-only, no scopes)
GITHUB_TOKEN=

# Optional: Qdrant server URL; empty means embedded local storage in lab1/data/index
QDRANT_URL=
